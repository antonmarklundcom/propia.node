# MySQL — Hostinger hPanel > Databases (free, included in the plan).
# For local dev: docker compose up -d  →  mysql://propia:propia@localhost:3306/propia
DATABASE_URL=mysql://user:password@localhost:3306/propia

# GoHighLevel — CRM of record for all leads. The portal only fires webhooks.
GHL_WEBHOOK_URL=
GHL_API_KEY=

# Cloudflare R2 — listing photos. Free tier: 10 GB, zero egress.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=propia-images
R2_PUBLIC_BASE_URL=https://img.propia.com.py

# Claude API — barrio guides + EN translations (batch jobs, not request path).
ANTHROPIC_API_KEY=

# Canonical host (listing detail pages are canonical here only).
NEXT_PUBLIC_CANONICAL_HOST=propia.com.py

# Cross-posting with terreno.com.py (separate repo/deploy, sibling site) —
# same secret must be set on both sides. See docs/PROPIA-MIGRATION.md in the
# terreno repo for the full contract.
FEED_SHARED_SECRET=
TERRENO_FEED_URL=https://terreno.com.py/api/feed/listings
