#!/bin/sh
# The local quality gate that replaces GitHub Actions. Faster than CI anyway:
# warm node_modules, warm .next/cache. Hostinger auto-deploys main and there is
# no staging, so a push that does not build is a live outage.
set -e
echo "pre-push: typecheck…"
npm run --silent typecheck
echo "pre-push: build…"
npm run --silent build
echo "pre-push: verify:import…"
npm run --silent verify:import
echo "pre-push: verify:facets…"
npm run --silent verify:facets
echo "pre-push: verify:i18n…"
npm run --silent verify:i18n
echo "pre-push: verify:seo…"
npm run --silent verify:seo
echo "pre-push: verify:rate-limit…"
npm run --silent verify:rate-limit
echo "pre-push: verify:inbox…"
npm run --silent verify:inbox
echo "pre-push: verify:prices…"
npm run --silent verify:prices
echo "pre-push: verify:telegram…"
npm run --silent verify:telegram
echo "pre-push: verify:reset…"
npm run --silent verify:reset
echo "pre-push: verify:ai-reply…"
npm run --silent verify:ai-reply
echo "pre-push: verify:whatsapp…"
npm run --silent verify:whatsapp
echo "pre-push: verify:publish…"
npm run --silent verify:publish
echo "pre-push: verify:lifecycle…"
npm run --silent verify:lifecycle
echo "pre-push: verify:proxy…"
npm run --silent verify:proxy
echo "pre-push: OK"
